{
    "id": null,
    "title": "Home Test - CDC Overview",
    "timezone": "browser",
    "panels": [
        {
            "type": "piechart",
            "title": "CDC ops (last 1h)",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "targets": [
                {
                    "expr": "sum by (op) (increase(cdc_events_total[1h]))",
                    "legendFormat": "{{op}}"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "right"
                },
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                }
            }
        },
        {
            "type": "table",
            "title": "CDC raw logs (Elasticsearch)",
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 24,
                "h": 10
            },
            "datasource": {
                "type": "elasticsearch",
                "uid": "Elasticsearch"
            },
            "targets": [
                {
                    "refId": "A",
                    "queryType": "lucene",
                    "query": "*",
                    "timeField": "@timestamp",
                    "format": "table",
                    "metrics": [
